{
    "name": "codatsoft/realtime",
    "version": "2.1.0",
    "description": "Voice rooms with a LiveKit agent, user-to-user calls, and the realtime channel conventions shared by Codatsoft Laravel products.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^v13.30.0.0",
        "guzzlehttp/guzzle": "^7.15.5",
        "laravel/sanctum": "^4.0",
        "agence104/livekit-server-sdk": "1.3.5",
        "ably/laravel-broadcaster": "^1.0",
        "codatsoft/codatbase": "4.4.0"
    },
    "autoload": {
        "psr-4": {
            "Codatsoft\\Realtime\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Bassel Hadba",
            "email": "bassel@codatsoft.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Codatsoft\\Realtime\\RealtimeServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
